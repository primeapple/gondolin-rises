    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
