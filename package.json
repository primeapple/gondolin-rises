{
  "name": "gondolin-rises",
  "version": "0.1.0",
  "description": "pi extension providing a configurable sandbox via Gondolin",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
